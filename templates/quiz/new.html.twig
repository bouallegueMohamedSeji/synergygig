{% extends 'base.html.twig' %}

{% block title %}Create New Quiz | SynergyGig{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-lg p-5 glass-card fade-in">
            <div class="text-center mb-5">
                <div class="mb-4">
                    <i class="bi bi-plus-circle text-primary" style="font-size: 4rem;"></i>
                </div>
                <h1 class="h3 fw-bold mb-2">Create New Quiz</h1>
                <p class="text-muted">Fill in the details to start building your professional quiz.</p>
            </div>

            {% if errors %}
                <div class="alert alert-danger mb-4">
                    <ul class="mb-0">
                        {% for error in errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-4">
                    <label for="title" class="form-label fw-semibold">Quiz Title</label>
                    <input type="text" id="title" name="title" class="form-control form-control-lg border-0 shadow-sm ps-4 py-3" 
                           placeholder="e.g. Introduction to Symfony 6" value="{{ app.request.request.get('title') }}">
                </div>

                <div class="mb-5">
                    <label for="course" class="form-label fw-semibold">Course Category</label>
                    <select id="course" name="course" class="form-select form-select-lg border-0 shadow-sm ps-4 py-3">
                        <option value="">Choose a course...</option>
                        {% for course in courses %}
                            <option value="{{ course.id }}" {{ app.request.request.get('course') == course.id ? 'selected' : '' }}>
                                {{ course.title }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="d-grid gap-3">
                    <button type="submit" class="btn btn-primary btn-lg py-3 fw-bold shadow">
                        <i class="bi bi-save me-2"></i> Create Quiz
                    </button>
                    <a href="{{ path('quiz_index') }}" class="btn btn-light btn-lg py-3 text-muted border-0 shadow-sm">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
