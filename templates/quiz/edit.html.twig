{% extends 'base.html.twig' %}

{% block title %}Edit Quiz: {{ quiz.title }} | SynergyGig{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-lg p-5 glass-card fade-in">
            <div class="text-center mb-5">
                <div class="mb-4">
                    <i class="bi bi-pencil-square text-accent" style="font-size: 4rem;"></i>
                </div>
                <h1 class="h3 fw-bold mb-2">Edit Quiz</h1>
                <p class="text-muted">Update the quiz title or category below.</p>
            </div>

            {% if errors %}
                <div class="alert alert-danger mb-4">
                    <ul class="mb-0">
                        {% for error in errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-4">
                    <label for="title" class="form-label fw-semibold">Quiz Title</label>
                    <input type="text" id="title" name="title" class="form-control form-control-lg border-0 shadow-sm ps-4 py-3" 
                           placeholder="Enter quiz title..." value="{{ quiz.title }}">
                </div>

                <div class="mb-5">
                    <label for="course" class="form-label fw-semibold">Course Category</label>
                    <select id="course" name="course" class="form-select form-select-lg border-0 shadow-sm ps-4 py-3">
                        <option value="">Choose a course...</option>
                        {% for course in courses %}
                            <option value="{{ course.id }}" {{ quiz.course and quiz.course.id == course.id ? 'selected' : '' }}>
                                {{ course.title }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="d-grid gap-3">
                    <button type="submit" class="btn btn-primary btn-lg py-3 fw-bold shadow">
                        <i class="bi bi-check2-circle me-2"></i> Save Changes
                    </button>
                    <a href="{{ path('quiz_show', {'id': quiz.id}) }}" class="btn btn-light btn-lg py-3 text-muted border-0 shadow-sm">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .glass-card { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(15px); border-radius: 24px; border: 1px solid rgba(255,255,255,0.4); }
    .form-control, .form-select { background: #f1f5f9; border-radius: 12px; transition: all 0.3s; }
    .form-control:focus, .form-select:focus { background: white; box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15); transform: translateY(-1px); }
</style>
{% endblock %}
