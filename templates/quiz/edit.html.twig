{% extends 'base.html.twig' %}

{% block title %}Edit Quiz: {{ quiz.title }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="h3 mb-4"><i class="bi bi-pencil"></i> Edit Quiz</h1>

        {% if errors %}
            <div class="alert alert-danger shadow-sm">
                <ul class="mb-0">
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <label for="title" class="form-label">Quiz Title</label>
                        <input type="text" id="title" name="title" class="form-control" required value="{{ quiz.title }}">
                    </div>

                    <div class="mb-4">
                        <label for="course" class="form-label">Associated Course</label>
                        <select id="course" name="course" class="form-select" required>
                            <option value="">Select a course...</option>
                            {% for course in courses %}
                                <option value="{{ course.id }}" {{ quiz.course and quiz.course.id == course.id ? 'selected' : '' }}>
                                    {{ course.title }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary d-flex align-items-center justify-content-center">
                            <i class="bi bi-save me-2"></i> Save Changes
                        </button>
                        <a href="{{ path('quiz_index') }}" class="btn btn-light">Back to list</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
