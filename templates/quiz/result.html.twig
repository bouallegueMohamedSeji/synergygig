{% extends 'base.html.twig' %}

{% block title %}Results: {{ quiz.title }} | SynergyGig{% endblock %}

{% block body %}
<div class="row justify-content-center pt-5">
    <div class="col-lg-7">
        <div class="card border-0 shadow-lg p-5 glass-card text-center fade-in {{ passed ? 'border-top-success' : 'border-top-danger' }}">
            <div class="mb-4">
                {% if passed %}
                    <div class="mx-auto bg-success text-white rounded-circle d-flex align-items-center justify-content-center shadow-lg mb-4" style="width: 100px; height: 100px;">
                        <i class="bi bi-award-fill" style="font-size: 3.5rem;"></i>
                    </div>
                    <h1 class="h2 fw-bold text-success mb-2">Congratulations!</h1>
                    <p class="h5 text-muted mb-4">You have successfully passed the exam.</p>
                {% else %}
                    <div class="mx-auto bg-danger text-white rounded-circle d-flex align-items-center justify-content-center shadow-lg mb-4" style="width: 100px; height: 100px;">
                        <i class="bi bi-exclamation-circle" style="font-size: 3.5rem;"></i>
                    </div>
                    <h1 class="h2 fw-bold text-danger mb-2">Not quite there yet!</h1>
                    <p class="h5 text-muted mb-4">Keep studying and try again to earn your certificate.</p>
                {% endif %}
            </div>

            <div class="bg-light rounded-4 p-4 mb-5 border">
                <div class="row align-items-center">
                    <div class="col-md-6 border-end text-center py-2">
                        <div class="display-4 fw-bold mb-0 {{ passed ? 'text-success' : 'text-danger' }}">{{ score }}%</div>
                        <small class="text-uppercase tracking-wider fw-semibold text-muted">Final Score</small>
                    </div>
                    <div class="col-md-6 text-center py-2">
                        <div class="h3 fw-bold mb-0">{{ correct }} / {{ total }}</div>
                        <small class="text-uppercase tracking-wider fw-semibold text-muted">Correct Answers</small>
                    </div>
                </div>
            </div>

            {% if passed %}
                <div class="alert alert-success border-0 shadow-sm p-4 rounded-4 mb-5">
                    <div class="d-flex align-items-center">
                        <div class="bg-white text-success rounded-circle p-2 me-3 shadow-sm">
                            <i class="bi bi-patch-check-fill fs-3"></i>
                        </div>
                        <div class="text-start">
                            <h5 class="fw-bold mb-1">Certification Awarded!</h5>
                            <p class="small mb-0">The <strong>{{ quiz.course ? quiz.course.title : 'Quiz' }}</strong> skill has been added to your profile achievements.</p>
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="d-grid gap-3">
                {% if passed %}
                    <a href="{{ path('quiz_index') }}" class="btn btn-primary btn-lg py-3 fw-bold rounded-pill shadow">
                        <i class="bi bi-house-door-fill me-2"></i> Return to Dashboard
                    </a>
                {% else %}
                    <a href="{{ path('quiz_take', {'id': quiz.id}) }}" class="btn btn-primary btn-lg py-3 fw-bold rounded-pill shadow">
                        <i class="bi bi-arrow-clockwise me-2"></i> Retake the Quiz
                    </a>
                {% endif %}
                <a href="{{ path('quiz_show', {'id': quiz.id}) }}" class="btn btn-light btn-lg py-3 text-muted border-0 shadow-sm">
                    View Quiz Details
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Confetti effect if passed -->
{% if passed %}
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var duration = 5 * 1000;
        var animationEnd = Date.now() + duration;
        var defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 0 };

        function randomInRange(min, max) {
            return Math.random() * (max - min) + min;
        }

        var interval = setInterval(function() {
            var timeLeft = animationEnd - Date.now();

            if (timeLeft <= 0) {
                return clearInterval(interval);
            }

            var particleCount = 50 * (timeLeft / duration);
            confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } }));
            confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } }));
        }, 250);
    });
</script>
{% endif %}

<style>
    .glass-card { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(20px); border-radius: 30px; border: 1px solid rgba(255,255,255,0.4); }
    .border-top-success { border-top: 8px solid #10b981 !important; }
    .border-top-danger { border-top: 8px solid #ef4444 !important; }
    .tracking-wider { letter-spacing: 0.1em; }
</style>
{% endblock %}
