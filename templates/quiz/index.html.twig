{% extends 'base.html.twig' %}

{% block title %}Quiz Management{% endblock %}

{% block body %}
<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        <h1 class="h3"><i class="bi bi-list-check"></i> List of Quizzes</h1>
    </div>
    <div class="col-md-6 text-end">
        <a href="{{ path('quiz_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Quiz
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search by title..." value="{{ search }}">
                </div>
            </div>
            <div class="col-md-5">
                <select name="course" class="form-select">
                    <option value="">All Courses</option>
                    {% for course in courses %}
                        <option value="{{ course.id }}" {{ currentCourse == course.id ? 'selected' : '' }}>{{ course.title }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Title</th>
                        <th>Course</th>
                        <th>Questions</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for quiz in quizzes %}
                        <tr>
                            <td class="ps-4">#{{ quiz.id }}</td>
                            <td class="fw-bold">{{ quiz.title }}</td>
                            <td>
                                <span class="badge badge-course text-dark">
                                    <i class="bi bi-book"></i> {{ quiz.course.title }}
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-info text-dark rounded-pill">
                                    {{ quiz.questions|length }} questions
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('quiz_show', {'id': quiz.id}) }}" class="btn btn-outline-dark" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('quiz_edit', {'id': quiz.id}) }}" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="{{ path('quiz_delete', {'id': quiz.id}) }}" style="display:inline-block" onsubmit="return confirm('Are you sure you want to delete this quiz?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ quiz.id) }}">
                                        <button class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No quizzes found.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
