{% extends 'base.html.twig' %}

{% block title %}Explore Quizzes | SynergyGig{% endblock %}

{% block body %}
<div class="row align-items-center mb-5">
    <div class="col-lg-6">
        <h1 class="display-5 fw-bold mb-2">Elevate Your Knowledge</h1>
        <p class="text-muted">Browse our collection of curated quizzes or create your own if you're an admin.</p>
    </div>
    <div class="col-lg-6 text-lg-end">
        {% if app.session.get('role') == 'ROLE_ADMIN' %}
            <a href="{{ path('quiz_new') }}" class="btn btn-primary btn-lg shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Create New Quiz
            </a>
        {% endif %}
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card p-4 mb-5 border-0 shadow-sm" style="background: rgba(255,255,255,0.6); backdrop-filter: blur(10px);">
    <form method="get" class="row g-3">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Search by quiz title..." value="{{ search }}">
            </div>
        </div>
        <div class="col-md-4">
            <select name="course" class="form-select border-0 shadow-none bg-white">
                <option value="">All Courses</option>
                {% for course in courses %}
                    <option value="{{ course.id }}" {{ currentCourse == course.id ? 'selected' : '' }}>{{ course.title }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">Apply Filters</button>
        </div>
    </form>
</div>

<!-- Quiz Grid -->
<div class="row g-4">
    {% for quiz in quizzes %}
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm quiz-card overflow-hidden">
                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-soft-primary text-primary px-3 py-2 rounded-pill small">
                            {{ quiz.course ? quiz.course.title : 'Uncategorized' }}
                        </span>
                        <div class="text-muted small">
                            <i class="bi bi-question-circle me-1"></i> {{ quiz.questions|length }} Qs
                        </div>
                    </div>
                    
                    <h3 class="h5 fw-bold mb-3">{{ quiz.title }}</h3>
                    
                    <div class="d-flex gap-2 mt-4">
                        <a href="{{ path('quiz_show', {'id': quiz.id}) }}" class="btn btn-light flex-grow-1 border">
                            View Details
                        </a>
                        
                        {% if app.session.get('role') == 'ROLE_ADMIN' %}
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary dropdown-toggle no-caret" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                    <li><a class="dropdown-item" href="{{ path('quiz_edit', {'id': quiz.id}) }}"><i class="bi bi-pencil me-2"></i> Edit</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" action="{{ path('quiz_delete', {'id': quiz.id}) }}" onsubmit="return confirm('Permanently delete this quiz?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ quiz.id) }}">
                                            <button type="submit" class="dropdown-item text-danger border-0 bg-transparent">
                                                <i class="bi bi-trash me-2"></i> Delete
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12 text-center py-5">
            <div class="mb-3">
                <i class="bi bi-inbox text-muted opacity-25" style="font-size: 5rem;"></i>
            </div>
            <h4 class="text-muted">No quizzes found.</h4>
            <p class="text-muted small">Try refining your search or filter.</p>
        </div>
    {% endfor %}
</div>

<style>
    .bg-soft-primary { background: #e0e7ff; color: #4338ca; }
    .quiz-card {
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .quiz-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.08) !important;
    }
    .no-caret::after { display: none; }
</style>
{% endblock %}
