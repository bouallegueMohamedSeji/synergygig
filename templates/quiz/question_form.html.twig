{% extends 'base.html.twig' %}

{% block title %}{{ mode == 'edit' ? 'Edit Question' : 'Add New Question' }} | SynergyGig{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-lg p-5 glass-card fade-in">
            <div class="text-center mb-5">
                <div class="mb-4">
                    <i class="bi {{ mode == 'edit' ? 'bi-pencil-square' : 'bi-question-circle' }} text-primary" style="font-size: 4rem;"></i>
                </div>
                <h1 class="h3 fw-bold mb-2">{{ mode == 'edit' ? 'Edit Question' : 'Add New Question' }}</h1>
                <p class="text-muted">For Quiz: <span class="text-primary fw-medium">{{ quiz.title }}</span></p>
            </div>

            {% if errors %}
                <div class="alert alert-danger mb-4">
                    <ul class="mb-0">
                        {% for error in errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-4">
                    <label for="question_text" class="form-label fw-semibold">Question Content</label>
                    <textarea id="question_text" name="question_text" class="form-control border-0 shadow-sm ps-4 py-3" 
                              rows="3" placeholder="What is the main advantage of Symfony?">{{ question is defined ? question.questionText : app.request.request.get('question_text') }}</textarea>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <label for="option_a" class="form-label fw-semibold">Option A</label>
                        <input type="text" id="option_a" name="option_a" class="form-control border-0 shadow-sm ps-4 py-3" 
                               value="{{ question is defined ? question.optionA : app.request.request.get('option_a') }}">
                    </div>
                    <div class="col-md-4">
                        <label for="option_b" class="form-label fw-semibold">Option B</label>
                        <input type="text" id="option_b" name="option_b" class="form-control border-0 shadow-sm ps-4 py-3" 
                               value="{{ question is defined ? question.optionB : app.request.request.get('option_b') }}">
                    </div>
                    <div class="col-md-4">
                        <label for="option_c" class="form-label fw-semibold">Option C</label>
                        <input type="text" id="option_c" name="option_c" class="form-control border-0 shadow-sm ps-4 py-3" 
                               value="{{ question is defined ? question.optionC : app.request.request.get('option_c') }}">
                    </div>
                </div>

                <div class="mb-5">
                    <label for="correct_option" class="form-label fw-semibold">Correct Answer</label>
                    <div class="row g-3">
                        {% for opt in ['A', 'B', 'C'] %}
                            <div class="col-md-4">
                                <input type="radio" class="btn-check" name="correct_option" id="btn-opt-{{ opt }}" value="{{ opt }}" 
                                       {{ (question is defined and question.correctOption == opt) or app.request.request.get('correct_option') == opt ? 'checked' : '' }}>
                                <label class="btn btn-outline-primary w-100 py-3 rounded-3" for="btn-opt-{{ opt }}">
                                    Option {{ opt }} is Correct
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="d-grid gap-3">
                    <button type="submit" class="btn btn-primary btn-lg py-3 fw-bold shadow">
                        <i class="bi bi-save me-2"></i> {{ mode == 'edit' ? 'Update Question' : 'Save Question' }}
                    </button>
                    <a href="{{ path('quiz_show', {'id': quiz.id}) }}" class="btn btn-light btn-lg py-3 text-muted border-0 shadow-sm">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .glass-card { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(15px); border-radius: 24px; border: 1px solid rgba(255,255,255,0.4); }
    .form-control { background: #f1f5f9; border-radius: 12px; transition: all 0.3s; }
    .form-control:focus { background: white; box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15); transform: translateY(-1px); }
    .btn-check:checked + .btn-outline-primary { background: var(--primary); color: white; border-color: var(--primary); box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3); }
</style>
{% endblock %}
